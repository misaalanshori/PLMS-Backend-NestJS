// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum BookReadingState {
  UNREAD
  PLAN_TO_READ
  READING
  READ
  DROPPED
}

model Book {
  id              Int              @id @default(autoincrement())
  title           String
  author          String
  description     String?          @db.Text
  summary         String?          @db.Text
  readingState    BookReadingState @default(UNREAD)
  tags            BookTag[]
  shelfId         Int?
  shelf           Shelf?           @relation(fields: [shelfId], references: [id])
  bookMediaAssets BookMediaAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model BookTag {
  bookId Int
  tagId  Int
  book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@id([bookId, tagId])
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  books     BookTag[]
  createdAt DateTime  @default(now())
}

model Shelf {
  id          Int      @id @default(autoincrement())
  name        String
  description String?  @db.Text
  books       Book[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MediaAssetType {
  IMAGE
  VIDEO
  RAW
}

enum MediaAssetStatus {
  PENDING
  ACTIVE
}

model MediaAsset {
  id              Int              @id @default(autoincrement())
  publicId        String           @unique
  resourceType    MediaAssetType
  format          String?
  version         String?
  uploadStatus    MediaAssetStatus @default(PENDING)
  bookMediaAssets BookMediaAsset[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model BookMediaAsset {
  bookId       Int
  mediaAssetId Int
  book         Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])
  order        Int

  @@id([bookId, mediaAssetId])
  @@unique([bookId, order])
}
